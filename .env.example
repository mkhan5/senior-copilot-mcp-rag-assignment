# Maintenance Copilot Environment Variables

# Gemini API Key (required for LLM functionality)
GEMINI_API_KEY=your_gemini_api_key_here
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langchain_api_key_here
LANGCHAIN_PROJECT=maintenance-copilot

# API URLs
MAINTENANCE_API_URL=http://localhost:8001
ALARM_API_URL=http://localhost:8000

# Server Ports
ALARM_API_HOST=0.0.0.0
ALARM_API_PORT=8000
MAINTENANCE_API_HOST=0.0.0.0
MAINTENANCE_API_PORT=8001
COPILOT_BACKEND_HOST=0.0.0.0
COPILOT_BACKEND_PORT=8002
FRONTEND_PORT=3000

# MCP Server URLs (streamable HTTP transport)
# Docker (services talk to each other by service name):
ALARM_MCP_URL=http://alarm-mcp:9000/mcp
MAINT_MCP_URL=http://maintenance-mcp:9001/mcp
# Local development (both servers started manually):
# ALARM_MCP_URL=http://localhost:9000/mcp
# MAINT_MCP_URL=http://localhost:9001/mcp

# RAG Configuration
DOCUMENTS_DIR=rag/documents
PERSIST_DIR=rag/chroma_db
COLLECTION_NAME=maintenance_docs
EMBEDDING_MODEL=all-MiniLM-L6-v2
GEMINI_MODEL=gemini-1.5-flash
TOP_K=5
SCORE_THRESHOLD=0.3
CHUNK_SIZE=500
CHUNK_OVERLAP=50